# Application
APP_NAME=AI Security Operations Platform
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-secret-key-at-least-32-chars
API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Demo seed user
SEED_ADMIN_EMAIL=admin@aisoc.local
SEED_ADMIN_PASSWORD=ChangeMeAdmin123!
SEED_ANALYST_EMAIL=analyst@aisoc.local
SEED_ANALYST_PASSWORD=ChangeMeAnalyst123!

# Postgres
POSTGRES_USER=aisoc
POSTGRES_PASSWORD=aisoc_secret
POSTGRES_DB=aisoc
DATABASE_URL=postgresql+psycopg://aisoc:aisoc_secret@localhost:5432/aisoc
DATABASE_URL_SYNC=postgresql+psycopg://aisoc:aisoc_secret@localhost:5432/aisoc

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=aisoc_knowledge

# JWT
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# OIDC (mock issuer for local; set real issuer in production)
OIDC_ENABLED=true
OIDC_ISSUER=http://localhost:8080/realms/aisoc
OIDC_CLIENT_ID=aisoc-frontend
OIDC_CLIENT_SECRET=aisoc-oidc-secret
OIDC_REDIRECT_URI=http://localhost:5173/auth/callback

# LLM — OpenAI-compatible primary
LLM_PRIMARY_BASE_URL=https://api.openai.com/v1
LLM_PRIMARY_API_KEY=
LLM_PRIMARY_MODEL=gpt-4o-mini

# LLM — Local (Ollama)
LLM_LOCAL_BASE_URL=http://localhost:11434/v1
LLM_LOCAL_API_KEY=ollama
LLM_LOCAL_MODEL=llama3.2

# Fallback order: primary,local,mock
LLM_FALLBACK_ORDER=primary,local,mock
LLM_EMBEDDING_MODEL=text-embedding-3-small
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100/minute

# Connectors (mock mode)
CONNECTOR_MODE=mock
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# Observability
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=aisoc-api
PROMETHEUS_ENABLED=true

# MCP
MCP_API_TOKEN=mcp-dev-token-change-me
BACKEND_INTERNAL_URL=http://localhost:8000
# Use streamable-http for Docker; stdio for Cursor/Claude Desktop
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8100

# Frontend (Vite / Docker build arg)
VITE_API_URL=http://localhost:8000
